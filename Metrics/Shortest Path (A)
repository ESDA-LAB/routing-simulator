import heapq

def heuristic(a, b):
    """Υπολογισμός Manhattan απόστασης"""
    return abs(a[0] - b[0]) + abs(a[1] - b[1])

def reconstruct_path(came_from, current):
    """Ανακατασκευή της πιο σύντομης διαδρομής από τον προορισμό προς την αρχή"""
    path = []
    while current in came_from:
        path.append(current)
        current = came_from[current]
    path.append(current)  # Προσθέτουμε την αρχή
    return path[::-1]  # Αντιστρέφουμε τη διαδρομή

def a_star_search(grid, start, goal):
    """A* Algorithm - Υπολογισμός του shortest path"""
    rows, cols = len(grid), len(grid[0])
    open_set = []
    heapq.heappush(open_set, (0, start))
    came_from = {}
    g_score = {start: 0}

    while open_set:
        _, current = heapq.heappop(open_set)

        if current == goal:
            return reconstruct_path(came_from, goal)  # Επιστροφή της διαδρομής

        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            neighbor = (current[0] + dx, current[1] + dy)
            
            if 0 <= neighbor[0] < rows and 0 <= neighbor[1] < cols and grid[neighbor[0]][neighbor[1]] != 1:
                tentative_g_score = g_score[current] + 1
                
                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:
                    g_score[neighbor] = tentative_g_score
                    priority = tentative_g_score + heuristic(neighbor, goal)
                    heapq.heappush(open_set, (priority, neighbor))
                    came_from[neighbor] = current

    return None  # Αν δεν βρεθεί μονοπάτι

# Παράδειγμα 10x10 grid
grid = [[0] * 10 for _ in range(10)]
grid[5][5] = 1  # Εμπόδιο

start = (0, 0)
goal = (9, 9)

shortest_path = a_star_search(grid, start, goal)
print("Πιο σύντομη διαδρομή:", shortest_path)
