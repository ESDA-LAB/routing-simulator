import numpy as np
import time

def floyd_warshall(graph):
    """Υλοποίηση του Floyd-Warshall με μέτρηση χρόνου εκτέλεσης"""
    num_vertices = len(graph)
    dist = np.array(graph, dtype=float)

    # Αρχικοποίηση: αντικατάσταση του 0 με άπειρο (εκτός της διαγωνίου)
    for i in range(num_vertices):
        for j in range(num_vertices):
            if i != j and dist[i][j] == 0:
                dist[i][j] = float('inf')

    # Έναρξη μέτρησης χρόνου
    start_time = time.perf_counter()

    # Εκτέλεση Floyd-Warshall
    for k in range(num_vertices):
        for i in range(num_vertices):
            for j in range(num_vertices):
                dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j])

    # Λήξη μέτρησης χρόνου
    end_time = time.perf_counter()
    
    execution_time = end_time - start_time  # Χρόνος εκτέλεσης

    return dist, execution_time

# Παράδειγμα γράφου (μηδενικά -> απουσία σύνδεσης)
graph = [
    [0, 3, 0, 0, 7],
    [3, 0, 1, 0, 5],
    [0, 1, 0, 2, 0],
    [0, 0, 2, 0, 3],
    [7, 5, 0, 3, 0]
]

# Υπολογισμός Floyd-Warshall
distances, exec_time = floyd_warshall(graph)

print(f"⏳ Χρόνος εκτέλεσης: {exec_time:.6f} δευτερόλεπτα")
