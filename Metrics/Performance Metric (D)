import heapq
import tracemalloc

def dijkstra_memory_usage(graph, start, goal):
    tracemalloc.start()  # Έναρξη παρακολούθησης μνήμης
    
    shortest_distance = {node: float('inf') for node in graph}
    shortest_distance[start] = 0
    pq = [(0, start)]
    
    while pq:
        current_distance, current_node = heapq.heappop(pq)
        if current_node == goal:
            break
        for neighbor, weight in graph[current_node]:
            distance = current_distance + weight
            if distance < shortest_distance[neighbor]:
                shortest_distance[neighbor] = distance
                heapq.heappush(pq, (distance, neighbor))
    
    current, peak = tracemalloc.get_traced_memory()  # Λήψη χρήσης μνήμης
    tracemalloc.stop()  # Σταματάμε την παρακολούθηση
    
    print(f"Μνήμη που χρησιμοποιήθηκε: {peak / 1024:.2f} KB")  # Μετατροπή σε KB
    return peak / 1024  # Επιστρέφουμε την αιχμή χρήσης μνήμης σε KB
