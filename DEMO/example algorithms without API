from dijkstra_shortest_path import DijkstraShortestPath
from bellman_ford_shortest_path import BellmanFordShortestPath

graph = [[1] * 16 for _ in range(16)]
obstacles = [(5, 5), (5, 6), (6, 5), (6, 6)]
for x, y in obstacles:
    graph[x][y] = float('inf')

start, end, map_size = (0, 0), (15, 15), (16, 16)

# Dijkstra
dijkstra = DijkstraShortestPath(graph)
print("Dijkstra:", dijkstra.FindRoute(start, end, obstacles, map_size))

# Bellman-Ford
bellman_ford = BellmanFordShortestPath(graph)
print("Bellman-Ford:", bellman_ford.FindRoute(start, end, obstacles, map_size))

